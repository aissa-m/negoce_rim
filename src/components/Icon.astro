---
import {
  ArrowRight,
  BadgeCheck,
  Building2,
  Factory,
  FileText,
  Fish,
  Globe2,
  Handshake,
  Home,
  Mail,
  MapPin,
  Menu,
  Moon,
  PackageSearch,
  Phone,
  Pickaxe,
  Ship,
  Sun,
  Waves
} from 'lucide-astro';

const { name = 'check' } = Astro.props;
const icons = {
  arrow: ArrowRight,
  check: BadgeCheck,
  document: FileText,
  factory: Factory,
  fish: Fish,
  globe: Globe2,
  handshake: Handshake,
  home: Home,
  mail: Mail,
  map: MapPin,
  menu: Menu,
  moon: Moon,
  oil: PackageSearch,
  phone: Phone,
  pickaxe: Pickaxe,
  ship: Ship,
  sun: Sun,
  trade: Building2,
  waves: Waves
};
const LucideIcon = icons[name] || BadgeCheck;
---
<LucideIcon class="icon" aria-hidden="true" />
