---
import Icon from './Icon.astro';
const { active = 'home' } = Astro.props;
const nav = [
  ['home','/','Home','Inicio','Accueil','trade'],
  ['about','/about/','About','Empresa','À propos','globe'],
  ['services','/services/','Services','Servicios','Services','handshake'],
  ['fisheries','/fisheries/','Fisheries','Pesca','Pêche','ship'],
  ['mining','/mining/','Mining','Minería','Mines','pickaxe'],
  ['deluxelube','/deluxelube/','DeluxeLube','DeluxeLube','DeluxeLube','oil'],
  ['contact','/contact/','Contact','Contacto','Contact','mail']
];
---
<header class="header">
  <div class="container header-row">
    <a href="/" aria-label="NÉGOCE ET COMMERCE DE RIM"><img class="logo" src="/original_logo.png" alt="NÉGOCE ET COMMERCE DE RIM" /></a>
    <nav class="nav" aria-label="Main navigation">
      {nav.map(([key,href,en,es,fr]) => <a class={active===key?'active':''} href={href} data-en={en} data-es={es} data-fr={fr}>{en}</a>)}
    </nav>
    <div class="actions">
      <button class="chip" data-lang-button="en">EN</button><button class="chip" data-lang-button="es">ES</button><button class="chip" data-lang-button="fr">FR</button>
      <button class="chip" data-theme-toggle aria-label="Toggle theme"><span data-theme-icon><Icon name="moon" /></span></button>
    </div>
    <button class="chip menu-btn" data-menu-toggle aria-label="Open menu"><Icon name="menu" /></button>
  </div>
  <div class="container mobile-nav" data-mobile-menu>
    {nav.map(([key,href,en,es,fr,icon]) => <a class={active===key?'active':''} href={href}><span class="icon-box"><Icon name={icon} /></span><span data-en={en} data-es={es} data-fr={fr}>{en}</span></a>)}
    <div style="display:flex;gap:8px;margin-top:10px;flex-wrap:wrap"><button class="chip" data-lang-button="en">EN</button><button class="chip" data-lang-button="es">ES</button><button class="chip" data-lang-button="fr">FR</button><button class="chip" data-theme-toggle aria-label="Toggle theme"><span data-theme-icon><Icon name="moon" /></span></button></div>
  </div>
</header>
