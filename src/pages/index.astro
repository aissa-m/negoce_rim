---
import Layout from '../components/Layout.astro';
import Icon from '../components/Icon.astro';
import SectionHeader from '../components/SectionHeader.astro';
---
<Layout active="home" title="NÉGOCE ET COMMERCE DE RIM — Trade, Fisheries, Mining & DeluxeLube" description="Mauritanian trading company focused on import-export, fisheries, mining resources and official DeluxeLube distribution.">
  <section class="section">
    <div class="container grid two" style="align-items:center">
      <div>
        <span class="badge"><Icon name="globe" /><span data-en="Mauritania based, internationally connected" data-es="Base en Mauritania, conexión internacional" data-fr="Basée en Mauritanie, connectée à l’international">Mauritania based, internationally connected</span></span>
        <h1 class="h1" data-en="A practical bridge for trade with Mauritania." data-es="Un puente práctico para comerciar con Mauritania." data-fr="Un pont pratique pour commercer avec la Mauritanie.">A practical bridge for trade with Mauritania.</h1>
        <p class="lead" data-en="NÉGOCE ET COMMERCE DE RIM develops structured opportunities in general trade, fisheries, mining resources and maritime lubricants. We connect serious partners with realistic commercial paths." data-es="NÉGOCE ET COMMERCE DE RIM desarrolla oportunidades estructuradas en comercio general, pesca, recursos mineros y lubricantes marítimos. Conectamos socios serios con vías comerciales realistas." data-fr="NÉGOCE ET COMMERCE DE RIM développe des opportunités structurées dans le commerce général, la pêche, les ressources minières et les lubrifiants maritimes. Nous connectons des partenaires sérieux avec des voies commerciales réalistes.">NÉGOCE ET COMMERCE DE RIM develops structured opportunities in general trade, fisheries, mining resources and maritime lubricants. We connect serious partners with realistic commercial paths.</p>
        <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:28px"><a class="btn btn-primary" href="/contact/"><Icon name="handshake" /><span data-en="Discuss an opportunity" data-es="Hablar de una oportunidad" data-fr="Discuter une opportunité">Discuss an opportunity</span></a><a class="btn btn-secondary" href="/deluxelube/"><Icon name="oil" /><span data-en="DeluxeLube distribution" data-es="Distribución DeluxeLube" data-fr="Distribution DeluxeLube">DeluxeLube distribution</span></a></div>
        <div class="stats"><div class="stat"><strong>4</strong><p class="muted" data-en="Core sectors" data-es="Sectores clave" data-fr="Secteurs clés">Core sectors</p></div><div class="stat"><strong>B2B</strong><p class="muted" data-en="Commercial focus" data-es="Enfoque comercial" data-fr="Orientation commerciale">Commercial focus</p></div><div class="stat"><strong>MR</strong><p class="muted" data-en="Mauritania market" data-es="Mercado mauritano" data-fr="Marché mauritanien">Mauritania market</p></div></div>
      </div>
      <div class="surface hero-card">
        <div class="grid two">
          <a class="card" href="/services/"><div class="icon-box"><Icon name="trade" /></div><h3 data-en="General commerce" data-es="Comercio general" data-fr="Commerce général">General commerce</h3><p class="muted" data-en="Import-export, sourcing and commercial representation." data-es="Import-export, sourcing y representación comercial." data-fr="Import-export, sourcing et représentation commerciale.">Import-export, sourcing and commercial representation.</p></a>
          <a class="card" href="/fisheries/"><div class="icon-box"><Icon name="ship" /></div><h3 data-en="Fisheries" data-es="Pesca" data-fr="Pêche">Fisheries</h3><p class="muted" data-en="Fish products, maritime operators and sector supplies." data-es="Productos pesqueros, operadores marítimos y suministros." data-fr="Produits de pêche, opérateurs maritimes et fournitures.">Fish products, maritime operators and sector supplies.</p></a>
          <a class="card" href="/mining/"><div class="icon-box"><Icon name="pickaxe" /></div><h3 data-en="Mining resources" data-es="Recursos mineros" data-fr="Ressources minières">Mining resources</h3><p class="muted" data-en="Minerals, metals and responsible project conversations." data-es="Minerales, metales y conversaciones responsables." data-fr="Minerais, métaux et discussions responsables.">Minerals, metals and responsible project conversations.</p></a>
          <a class="card" href="/deluxelube/"><div class="icon-box"><Icon name="oil" /></div><h3>DeluxeLube</h3><p class="muted" data-en="Official distribution in Mauritania." data-es="Distribución oficial en Mauritania." data-fr="Distribution officielle en Mauritanie.">Official distribution in Mauritania.</p></a>
        </div>
      </div>
    </div>
  </section>
  <section class="section-sm"><div class="container"><SectionHeader kicker="Our role" kickerEs="Nuestro papel" kickerFr="Notre rôle" title="From opportunity to practical next steps." titleEs="De la oportunidad a los próximos pasos prácticos." titleFr="De l’opportunité aux prochaines étapes concrètes." lead="We help clarify what can be sourced, imported, exported or represented, then coordinate the first serious commercial conversations." leadEs="Ayudamos a aclarar qué se puede conseguir, importar, exportar o representar, y después coordinamos las primeras conversaciones comerciales serias." leadFr="Nous aidons à clarifier ce qui peut être sourcé, importé, exporté ou représenté, puis nous coordonnons les premiers échanges commerciaux sérieux." /></div></section>
  <section class="section-sm"><div class="container grid three"><div class="card"><div class="icon-box"><Icon name="globe" /></div><h3 data-en="Market orientation" data-es="Orientación de mercado" data-fr="Orientation marché">Market orientation</h3><p class="muted" data-en="Mauritania can be a destination market, a source of supply or a strategic point for regional relationships." data-es="Mauritania puede ser mercado de destino, origen de suministro o punto estratégico para relaciones regionales." data-fr="La Mauritanie peut être un marché de destination, une source d’approvisionnement ou un point stratégique régional.">Mauritania can be a destination market, a source of supply or a strategic point for regional relationships.</p></div><div class="card"><div class="icon-box"><Icon name="document" /></div><h3 data-en="Structured coordination" data-es="Coordinación estructurada" data-fr="Coordination structurée">Structured coordination</h3><p class="muted" data-en="We focus on specifications, quantities, timing, documents and realistic execution before promises." data-es="Nos centramos en especificaciones, cantidades, plazos, documentos y ejecución realista antes de prometer." data-fr="Nous privilégions spécifications, quantités, délais, documents et exécution réaliste avant les promesses.">We focus on specifications, quantities, timing, documents and realistic execution before promises.</p></div><div class="card"><div class="icon-box"><Icon name="handshake" /></div><h3 data-en="Long-term partners" data-es="Socios a largo plazo" data-fr="Partenaires durables">Long-term partners</h3><p class="muted" data-en="We are interested in serious companies looking for discreet, reliable and repeatable cooperation." data-es="Nos interesan empresas serias que buscan cooperación discreta, fiable y repetible." data-fr="Nous recherchons des entreprises sérieuses visant une coopération discrète, fiable et répétable.">We are interested in serious companies looking for discreet, reliable and repeatable cooperation.</p></div></div></section>
  <section class="section-sm"><div class="container surface" style="border-radius:34px;padding:36px"><div class="grid two" style="align-items:center"><div><div class="kicker">DeluxeLube</div><h2 class="h2" data-en="Official distributor in Mauritania." data-es="Distribuidor oficial en Mauritania." data-fr="Distributeur officiel en Mauritanie.">Official distributor in Mauritania.</h2><p class="lead" data-en="We currently import Deluxe 2T Virgin Oil, a 2-stroke outboard motor oil, serving maritime activity, fishing operators, workshops and distributors." data-es="Actualmente importamos Deluxe 2T Virgin Oil, aceite para motor fuera borda de 2 tiempos, orientado a actividad marítima, operadores pesqueros, talleres y distribuidores." data-fr="Nous importons actuellement Deluxe 2T Virgin Oil, une huile moteur hors-bord 2 temps, destinée à l’activité maritime, aux opérateurs de pêche, ateliers et distributeurs.">We currently import Deluxe 2T Virgin Oil, a 2-stroke outboard motor oil, serving maritime activity, fishing operators, workshops and distributors.</p></div><a class="btn btn-primary" href="/deluxelube/"><Icon name="arrow" /><span data-en="View product page" data-es="Ver página del producto" data-fr="Voir la page produit">View product page</span></a></div></div></section>
</Layout>
