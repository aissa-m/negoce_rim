---
import Layout from '../components/Layout.astro';
import Icon from '../components/Icon.astro';
---
<Layout active="contact" title="Contact — NÉGOCE ET COMMERCE DE RIM" description="Contact NÉGOCE ET COMMERCE DE RIM for trade, fisheries, mining and DeluxeLube opportunities.">
  <section class="section"><div class="container grid two"><div><div class="kicker" data-en="Contact" data-es="Contacto" data-fr="Contact">Contact</div><h1 class="h1" data-en="Tell us what you are looking for." data-es="Cuéntanos qué estás buscando." data-fr="Dites-nous ce que vous recherchez.">Tell us what you are looking for.</h1><p class="lead" data-en="For DeluxeLube supply, fisheries, mining resources or general trade opportunities, send us a message and we will reply with practical next steps." data-es="Para suministro DeluxeLube, pesca, recursos mineros u oportunidades de comercio general, envíanos un mensaje y responderemos con próximos pasos prácticos." data-fr="Pour DeluxeLube, la pêche, les ressources minières ou le commerce général, envoyez-nous un message et nous répondrons avec des étapes concrètes.">For DeluxeLube supply, fisheries, mining resources or general trade opportunities, send us a message and we will reply with practical next steps.</p><div class="grid" style="margin-top:30px"><div class="card"><div class="icon-box"><Icon name="mail" /></div><h3>Email</h3><p><a class="muted" href="mailto:negocederim@gmail.com">negocederim@gmail.com</a></p></div><div class="card"><div class="icon-box"><Icon name="phone" /></div><h3 data-en="Phone" data-es="Teléfono" data-fr="Téléphone">Phone</h3><p><a class="muted" href="tel:+34632527546">+34 632 52 75 46</a><br/><a class="muted" href="tel:+22247951096">+222 47 95 10 96</a></p></div><div class="card"><div class="icon-box"><Icon name="map" /></div><h3 data-en="Location" data-es="Ubicación" data-fr="Adresse">Location</h3><p class="muted">Tevragh Zeina, Nouakchott, Mauritania</p></div></div></div><div class="surface" style="border-radius:34px;padding:32px"><form name="contact" method="POST" action="/thank-you/" data-netlify="true" data-netlify-honeypot="bot-field" class="grid"><input type="hidden" name="form-name" value="contact"/><p style="display:none"><label>Don’t fill this out: <input name="bot-field" /></label></p><input class="form-control" name="name" required placeholder="Your name" data-placeholder-en="Your name" data-placeholder-es="Tu nombre" data-placeholder-fr="Votre nom"/><input class="form-control" name="company" placeholder="Company (optional)" data-placeholder-en="Company (optional)" data-placeholder-es="Empresa (opcional)" data-placeholder-fr="Entreprise (optionnel)"/><input class="form-control" name="subject" required placeholder="Subject" data-placeholder-en="Subject" data-placeholder-es="Asunto" data-placeholder-fr="Sujet"/><textarea class="form-control" name="message" rows="7" placeholder="Details: product, quantity, destination, timeline..." data-placeholder-en="Details: product, quantity, destination, timeline..." data-placeholder-es="Detalles: producto, cantidad, destino, plazos..." data-placeholder-fr="Détails : produit, quantité, destination, délais..."></textarea><button class="btn btn-primary" type="submit"><Icon name="arrow" /><span data-en="Send request" data-es="Enviar solicitud" data-fr="Envoyer la demande">Send request</span></button></form></div></div></section>
</Layout>
