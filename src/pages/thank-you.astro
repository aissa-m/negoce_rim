<Layout active="contact" title="Thank you — NÉGOCE ET COMMERCE DE RIM" description="Thank you for contacting NÉGOCE ET COMMERCE DE RIM.">
  <section class="section"><div class="container" style="max-width:760px;text-align:center"><div class="surface" style="border-radius:34px;padding:46px"><div class="icon-box" style="margin:0 auto;width:68px;height:68px"><Icon name="check" /></div><h1 class="h2" data-en="Thank you. We received your request." data-es="Gracias. Hemos recibido tu solicitud." data-fr="Merci. Nous avons bien reçu votre demande.">Thank you. We received your request.</h1><p class="lead" data-en="We will reply shortly with practical next steps." data-es="Responderemos pronto con próximos pasos prácticos." data-fr="Nous répondrons rapidement avec des étapes concrètes.">We will reply shortly with practical next steps.</p><a class="btn btn-primary" href="/" style="margin-top:22px"><Icon name="arrow" /><span data-en="Back to home" data-es="Volver al inicio" data-fr="Retour à l’accueil">Back to home</span></a></div></div></section>
</Layout>
